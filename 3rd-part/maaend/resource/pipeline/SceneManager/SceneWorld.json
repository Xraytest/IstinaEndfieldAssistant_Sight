{
    "__ScenePrivateWorldSpaceExit": {
        "desc": "从大世界协议空间、好友飞船退出。timeout=2000 确保非协议空间时快速失败（避免 60s 等待阻塞 SceneAnyEnterWorld）",
        "recognition": "TemplateMatch",
        "roi": [
            0,
            0,
            100,
            100
        ],
        "template": [
            "SceneManager/WorldSpaceExit.png",
            "SceneManager/WorldSpaceExit1.png"
        ],
        "pre_wait_freezes": 200,
        "pre_delay": 0,
        "action": "Click",
        "max_hit": 5,
        "post_delay": 0,
        "timeout": 2000,
        "next": [
            "__ScenePrivateWorldSpaceExitConfirm",
            "__ScenePrivateEndVisit"
        ]
    },
    "__ScenePrivateWorldStorySkip": {
        "desc": "大世界剧情跳过。timeout=2000 确保非剧情跳过按钮时快速失败（避免 60s 等待阻塞 SceneAnyEnterWorld）",

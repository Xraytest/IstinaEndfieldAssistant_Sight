    "__ScenePrivateAnyEnterWorldSuccess": {
        "desc": "从任意界面进入大世界成功。使用 InWorld 模板匹配 + 探索 OCR ROI [0,0,250,80] 双重验证，避免云终末地菜单列表误判。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": "OCR",
                        "roi": [0, 0, 250, 80],
                        "expected": ["探索"],
                        "threshold": 0.7
                    }
                ]
            }
        },
        "pre_wait_freezes": {
            "target": [70, 80, 70, 60],
            "time": 800,
            "timeout": 2000
        },
        "timeout": 2000,
        "pre_delay": 0,
        "post_delay": 0
    },
